# Local development defaults. Copy this file to .env and change the secret.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false

# Production deployments may also need:
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=true
# DJANGO_TRUST_PROXY_HEADER=true

# Relative paths are resolved from the repository root.
CAR_PRICE_MODEL_PATH=artifacts/car_price_pipeline.joblib
